# bitbucket-mcp configuration. Copy to ~/.config/bb/bitbucket-mcp.env (mode 600)
# and point the systemd unit's EnvironmentFile= at it. Every variable is optional.

# Repository used when a command has no --repo, as WORKSPACE/SLUG. Default: none.
BB_DEFAULT_REPO=

# Address and port the MCP server listens on. Keep it on the loopback
# interface and put a tunnel or reverse proxy in front for remote clients.
BB_MCP_BIND=127.0.0.1
BB_MCP_PORT=8765

# File holding the bearer secret (created by `bb mcp-serve --init-secret`).
BB_MCP_SECRET_FILE=~/.config/bb/mcp-secret

# Public host names that reach this server, comma-separated, for example the
# hostname of a Cloudflare Tunnel route. Requests for any other Host get 421.
BB_MCP_PUBLIC_HOSTS=
